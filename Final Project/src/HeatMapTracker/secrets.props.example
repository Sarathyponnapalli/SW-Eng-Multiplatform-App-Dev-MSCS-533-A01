<Project>
	<!--
		Local secrets template. To use:
		  1. Copy this file to secrets.props (same folder). secrets.props is git-ignored.
		  2. Replace the placeholder with your Google Maps SDK for Android key.
		  3. In Google Cloud Console, restrict the key to:
		       - Application: Android apps, package com.mscs533.heatmaptracker + your signing SHA-1
		       - API: Maps SDK for Android only
		Never commit a real key: a Maps key ships inside the APK, so restriction is the real protection.
	-->
	<PropertyGroup>
		<MapsApiKey>YOUR_ANDROID_MAPS_KEY</MapsApiKey>
	</PropertyGroup>
</Project>
