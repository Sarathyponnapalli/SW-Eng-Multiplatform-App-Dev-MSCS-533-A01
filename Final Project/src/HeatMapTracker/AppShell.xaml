<?xml version="1.0" encoding="UTF-8" ?>
<!-- App navigation shell. MainView is resolved through dependency injection (see MauiProgram). -->
<Shell
    x:Class="HeatMapTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HeatMapTracker.Views"
    Title="Heat Map Tracker">

    <ShellContent
        Title="MainView"
        ContentTemplate="{DataTemplate views:MainView}"
        Route="MainView" />

</Shell>
