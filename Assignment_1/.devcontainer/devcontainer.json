{
  "name": "Flutter Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "forwardPorts": [8080],
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/setup-flutter.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  }
}
